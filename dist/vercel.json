{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sitemap\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(site\\.webmanifest|manifest\\.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|mp4|png|jpg|jpeg|svg|ttf|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/darshan",
      "destination": "/darshan/index.html"
    },
    {
      "source": "/darshan/(.*)",
      "destination": "/darshan/index.html"
    },
    {
      "source": "/works",
      "destination": "/works.html"
    },
    {
      "source": "/work-selection",
      "destination": "/works.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/video-archive",
      "destination": "/video-archive.html"
    },
    {
      "source": "/poster-archive",
      "destination": "/poster-archive.html"
    },
    {
      "source": "/instagram-reels",
      "destination": "/video-archive.html"
    },
    {
      "source": "/reels",
      "destination": "/video-archive.html"
    },
    {
      "source": "/triadlight",
      "destination": "/video-archive.html"
    },
    {
      "source": "/posters",
      "destination": "/poster-archive.html"
    },
    {
      "source": "/travel-posters",
      "destination": "/poster-archive.html"
    },
    {
      "source": "/itmatters",
      "destination": "/poster-archive.html"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/reach-out",
      "destination": "/"
    }
  ]
}